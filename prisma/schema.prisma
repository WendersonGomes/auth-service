generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
   moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @db.Uuid
  email String?
  displayName String?
  avatarUrl String?

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email])
  @@map("profiles")
}